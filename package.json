{
  "name": "fibli-studio",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first workspace for writing, worldbuilding, and research.",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": "12.23.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fibli/client dev",
    "build": "pnpm --filter @fibli/client build",
    "typecheck": "pnpm --filter @fibli/client typecheck",
    "preview": "pnpm --filter @fibli/client preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm --filter @fibli/client test",
    "test:watch": "pnpm --filter @fibli/client test:watch",
    "check": "biome ci . && pnpm typecheck && pnpm test && pnpm build",
    "tauri": "pnpm --filter @fibli/client tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9"
  }
}
